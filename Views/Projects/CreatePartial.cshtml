@model ProjectManagerApp.Models.Project

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Projektets namn *@
    <div class="form-group">
        <label asp-for="Name" class="control-label">Project Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    @* Kundens namn *@
    <div class="form-group">
        <label asp-for="ClientName" class="control-label">Client Name</label>
        <input asp-for="ClientName" class="form-control" />
        <span asp-validation-for="ClientName" class="text-danger"></span>
    </div>

    @*  Projektbeskrivning *@
    <div class="form-group">
        <label asp-for="Description" class="control-label">Description</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    @* Startdatum med fallback om modellen är tom – skapat med hjälp av ChatGPT *@
    <div class="form-group">
        <label asp-for="StartDate" class="control-label">Start Date</label>
        <input asp-for="StartDate" class="form-control" type="datetime-local"
               value="@(Model.StartDate > DateTime.MinValue ? Model.StartDate.ToString("yyyy-MM-ddTHH:mm") : "")" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    @* Slutdatum med samma logik som ovan – skapat med hjälp av ChatGPT *@
    <div class="form-group">
        <label asp-for="EndDate" class="control-label">End Date</label>
        <input asp-for="EndDate" class="form-control" type="datetime-local"
               value="@(Model.EndDate > DateTime.MinValue ? Model.EndDate.ToString("yyyy-MM-ddTHH:mm") : "")" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    @* Budgetfält *@
    <div class="form-group">
        <label asp-for="Budget" class="control-label">Budget</label>
        <input asp-for="Budget" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Budget" class="text-danger"></span>
    </div>

    @* Enum-dropdown för att välja status *@
    <div class="form-group">
        <label asp-for="Status" class="control-label">Status</label>
        <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<ProjectManagerApp.Models.ProjectStatus>()">
            <option value="">-- Select status --</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    @* Ikonval + förhandsvisning. Dropdown kombinerat med dynamisk bild – skapad med hjälp av chat gpt *@
    <div class="form-group">
        <label asp-for="IconFileName" class="control-label">Project Icon</label>
        <select asp-for="IconFileName" class="form-control" id="iconSelect" onchange="updateIconPreview()">
            <option value="project-image.png">Project Image</option>
            <option value="icon1.png">Icon 1</option>
            <option value="icon2.png">Icon 2</option>
            <option value="icon3.png">Icon 3</option>
            <option value="icon4.png">Icon 4</option>
        </select>
        <span asp-validation-for="IconFileName" class="text-danger"></span>

        <div class="mt-2">
            <img id="iconPreview" src="/images/projects/icon1.png" alt="Preview" width="100" height="100" />
        </div>
    </div>

    @* Submit-knapp *@
    <div class="form-group mt-3 text-end">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

@* Förhandsvisning av vald ikon – uppdateras direkt när man ändrar dropdown. Skapad med hjälp av chat gpt *@
<script>
    function updateIconPreview() {
        const selectedValue = document.getElementById("iconSelect").value;
        const previewImage = document.getElementById("iconPreview");
        previewImage.src = `/images/projects/${selectedValue}`;
    }
</script>
