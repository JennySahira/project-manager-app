<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectManagerApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectManagerApp.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="layout-wrapper">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="app-logo">
                    <img src="@Url.Content("~/images/projects/logo.png")" alt="Alpha Logo" />
                    <span class="app-title">alpha</span>
                </div>
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Projects" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M3 7h18M3 12h18M3 17h18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Projects
                    </a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="Privacy">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15A7.974 7.974 0 0 0 21 12a8 8 0 1 0-9.9 7.9" />
                        </svg>
                        Privacy
                    </a>
                </li>
            </ul>
        </aside>

        <!-- MAIN AREA -->
        <div class="main-content">

            <!-- TOPBAR -->
            <div class="topbar">
                <div class="dropdown profile-dropdown ms-auto">
                    <button class="btn d-flex align-items-center" type="button" id="profileMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@Url.Content("~/images/projects/Avatar.png")" alt="Avatar" class="rounded-circle" width="40" height="40" />
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="profileMenuButton">
                        <li class="px-3 py-2 text-center">
                            <img src="@Url.Content("~/images/projects/Avatar.png")" class="rounded-circle mb-2" width="48" height="48" />
                            <div class="fw-bold">@User.Identity?.Name</div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>

                        </li>
                    </ul>
                </div>
            </div>

            <!-- MAIN BODY -->
            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="border-top footer text-muted mt-4">
                <div class="container">
                    &copy; 2025 - ProjectManagerApp - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
